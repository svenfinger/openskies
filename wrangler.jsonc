{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openskies",
  "main": "./src/worker.ts",
  // Set this to today's date
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    // Keep the download proxy on the Worker; everything else is static assets.
    "run_worker_first": ["/download/*"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "routes": [{ "pattern": "openskies.photos", "custom_domain": true }],
  // Do not load Astro/R2 `.env` keys into the Worker runtime.
  "secrets": {
    "required": [],
  },
}
