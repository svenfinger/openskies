---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import displayFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import displayItalicFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import bodyFont from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';
import { SITE_NAME } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE_NAME,
  description = 'Free sky photos to download and use.',
} = Astro.props;

const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL('/share.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={displayFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={bodyFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {['/', '/about', '/about/'].includes(Astro.url.pathname) && (
      <link
        rel="preload"
        href={displayItalicFont}
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={shareImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage.href} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="main-content" class="site-main site-shell" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
