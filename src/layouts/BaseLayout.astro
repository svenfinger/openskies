---
import SiteFooter from '../components/SiteFooter.tsx';
import SiteHeader from '../components/SiteHeader.tsx';
import { SITE_NAME } from '../config';

interface Props {
  title?: string;
  description?: string;
  containerSize?: '2' | '4';
  containerAlign?: 'left' | 'center';
  /** Radix spacing scale for vertical padding (8 = 32px, 9 = 40px). */
  containerPy?: '8' | '9';
}

const {
  title = SITE_NAME,
  description = 'Free sky photos to download and use.',
  containerSize = '4',
  containerAlign = 'left',
  containerPy = '8',
} = Astro.props;

const containerAlignClass =
  containerAlign === 'center' ? 'rt-r-ai-center' : '';

const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL('/share.png', Astro.site);
---

<!doctype html>
<!-- Radix Theme: accentColor=blue grayColor=mauve radius=large appearance=light -->
<html
  lang="en"
  class="radix-themes light"
  data-is-root-theme="true"
  data-accent-color="blue"
  data-gray-color="mauve"
  data-radius="large"
  data-scaling="100%"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={shareImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage.href} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <SiteHeader />
    </header>
    <main class="site-main">
      <div
        class:list={[
          'site-container',
          'rt-Container',
          `rt-r-size-${containerSize}`,
          containerAlignClass,
          `rt-r-py-${containerPy}`,
          'rt-r-px-4',
        ]}
      >
        <div class="rt-ContainerInner">
          <slot />
        </div>
      </div>
    </main>
    <footer class="site-footer">
      <SiteFooter />
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .site-header {
    border-bottom: 1px solid var(--gray-a6);
  }

  .site-footer {
    border-top: 1px solid var(--gray-a6);
  }

</style>
