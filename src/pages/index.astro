---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.tsx';
import photosJson from '../data/photos.json';
import type { Photo } from '../types/photo';

const photos = photosJson as Photo[];
---

<BaseLayout>
  <header class="collection-intro">
    <div>
      <p class="eyebrow">An open collection of sky photography</p>
      <h1 class="hero-title">
        A little more <em>sky.</em>
      </h1>
    </div>
    <p class="intro-description">
      Clouds, light, and the space in between.
      <br />
      Free sky photos to download and use under the{' '}
      <a href="/license">OpenSkies license</a>.
    </p>
  </header>
  <Gallery client:load photos={photos} />
</BaseLayout>
