---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.tsx';
import photosJson from '../data/photos.json';
import type { Photo } from '../types/photo';

const photos = photosJson as Photo[];
---

<BaseLayout>
  <div class="space-y-12 pt-8">
    <header class="flex flex-col items-center space-y-4 text-center">
      <h1 class="font-heading text-3xl font-medium tracking-tight sm:text-4xl">
        Welcome to OpenSkies
      </h1>
      <p class="max-w-[40ch] text-muted-foreground">
        Free sky photos to download and use under the <a class="underline underline-offset-4 hover:text-foreground" href="/license">OpenSkies license</a>.
      </p>
    </header>
    <Gallery client:load photos={photos} />
  </div>
</BaseLayout>
