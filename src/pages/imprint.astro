---
import ProseLayout from '../layouts/ProseLayout.astro';
import { siteOperator, siteUrl } from '../lib/site-operator';
---

<ProseLayout
  title="Imprint"
  description="Legal imprint for OpenSkies."
>
  <h2>Service provider</h2>
  <p>
    {siteOperator.name}<br />
    {siteOperator.addressLines.map((line) => (
      <>
        {line}
        <br />
      </>
    ))}
  </p>

  <h2>Contact</h2>
  <p>
    Email: <a href={`mailto:${siteOperator.email}`}>{siteOperator.email}</a><br />
    Website: <a href={siteUrl}>{siteUrl.replace('https://', '')}</a>
  </p>

  <h2>Responsible for content</h2>
  <p>{siteOperator.name} (address as above).</p>
</ProseLayout>
