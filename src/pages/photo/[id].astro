---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoDownloads from '../../components/PhotoDownloads.tsx';
import { SITE_NAME, photoUrl } from '../../config';
import photosJson from '../../data/photos.json';
import {
  getNeighbors,
  photoLabel,
  previewDimensions,
  sortPhotosById,
} from '../../lib/photos';
import type { Photo } from '../../types/photo';

export function getStaticPaths() {
  const photos = sortPhotosById(photosJson as Photo[]);
  return photos.map((photo) => ({
    params: { id: photo.id },
    props: { photo },
  }));
}

interface Props {
  photo: Photo;
}

const { photo } = Astro.props;
const photos = sortPhotosById(photosJson as Photo[]).reverse();
const { prev, next } = getNeighbors(photos, photo.id);
const label = photoLabel(photo.id);
const preview = previewDimensions(photo);
const previewSrc = photoUrl(photo.id, 'preview.jpg');
---

<BaseLayout title={label} description={`Download ${label} — free sky photo from ${SITE_NAME}.`}>
  <article class="flex w-full flex-col gap-8">
    <nav class="grid w-full grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-x-4 text-sm" aria-label="Photo navigation">
      <div>
        {
          prev ? (
            <a class="block truncate text-muted-foreground hover:text-foreground" href={`/photo/${prev.id}`}>
              ← {photoLabel(prev.id)}
            </a>
          ) : null
        }
      </div>
      <div class="justify-self-center">
        <a class="block font-medium text-muted-foreground hover:text-foreground" href="/">All photos</a>
      </div>
      <div class="justify-self-end text-right">
        {
          next ? (
            <a class="block truncate text-muted-foreground hover:text-foreground" href={`/photo/${next.id}`}>
              {photoLabel(next.id)} →
            </a>
          ) : null
        }
      </div>
    </nav>

    <div class="flex w-full flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
      <h1 class="m-0 font-heading text-xl font-medium">{label}</h1>
      <div class="flex sm:justify-end">
        <PhotoDownloads client:load photoId={photo.id} />
      </div>
    </div>

    <figure class="m-0 w-full overflow-hidden rounded-xl bg-muted">
      <img
        class="block h-auto w-full object-contain object-center"
        src={previewSrc}
        alt={label}
        width={preview.width}
        height={preview.height}
        decoding="async"
        fetchpriority="high"
      />
    </figure>

    <p class="m-0 text-center text-sm text-muted-foreground">
      Free to use under the <a class="underline decoration-1 underline-offset-4 hover:text-foreground" href="/license">OpenSkies license</a>.
    </p>
  </article>
</BaseLayout>
