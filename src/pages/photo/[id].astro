---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoDownloads from '../../components/PhotoDownloads.tsx';
import { SITE_NAME, photoUrl } from '../../config';
import photosJson from '../../data/photos.json';
import {
  getNeighbors,
  photoLabel,
  photoDescription,
  previewDimensions,
  sortPhotosById,
} from '../../lib/photos';
import type { Photo } from '../../types/photo';

export function getStaticPaths() {
  const photos = sortPhotosById(photosJson as Photo[]);
  return photos.map((photo) => ({
    params: { id: photo.id },
    props: { photo },
  }));
}

interface Props {
  photo: Photo;
}

const { photo } = Astro.props;
const photos = sortPhotosById(photosJson as Photo[]).reverse();
const { prev, next } = getNeighbors(photos, photo.id);
const label = photoLabel(photo.id);
const preview = previewDimensions(photo);
const previewSrc = photoUrl(photo.id, 'preview.jpg');
---

<BaseLayout
  title={label}
  description={`Download ${label} — free sky photo from ${SITE_NAME}.`}
>
  <article class="photo-page">
    <nav class="photo-page-navigation" aria-label="Photo navigation">
      <a href="/">← All photographs</a>
      <div class="photo-page-steps">
        {prev ? (
          <a
            href={`/photo/${prev.id}`}
            aria-label={`Previous photograph ${photoLabel(prev.id)}`}
          >
            ← {photoLabel(prev.id)}
          </a>
        ) : null}
        {next ? (
          <a
            href={`/photo/${next.id}`}
            aria-label={`Next photograph ${photoLabel(next.id)}`}
          >
            {photoLabel(next.id)} →
          </a>
        ) : null}
      </div>
    </nav>

    <div class="photo-page-header">
      <div class="photo-page-title">
        <h1>{label}</h1>
        <span class="small-text">
          {photo.width} × {photo.height}
        </span>
      </div>
      <PhotoDownloads client:load photo={photo} />
    </div>

    <figure class="photo-page-stage">
      <img
        src={previewSrc}
        alt={photoDescription(photo)}
        width={preview.width}
        height={preview.height}
        decoding="async"
        fetchpriority="high"
      />
    </figure>

    <div class="photo-page-note">
      <p>{photoDescription(photo)}</p>
      <p>
        Free to use under the <a href="/license">OpenSkies license</a>.
      </p>
    </div>
  </article>
</BaseLayout>
